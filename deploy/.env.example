# Biến môi trường cho Docker Compose dev (deploy/docker-compose.yml).
# Chép file này thành deploy/.env rồi chỉnh. KHÔNG commit deploy/.env.

# --- PostgreSQL (Ngày 3) ---
POSTGRES_USER=cdp
POSTGRES_PASSWORD=cdp_dev_pw
POSTGRES_DB=cdp
POSTGRES_PORT=5432

# --- Core_API (Ngày 15) ---
# Môi trường ASP.NET trong container (Development|Staging|Production).
ASPNETCORE_ENVIRONMENT=Production
# Cổng host map tới core-api (container luôn nghe 8080).
CORE_API_PORT=8080
# App:SelfUrl trong container (override mặc định https://localhost:44382 của dev).
CORE_API_SELF_URL=http://localhost:8080

# --- Các biến dưới đây thêm dần ở các ngày sau (chỉ liệt kê trước để tham khảo) ---
# BFF / Object_Storage (MinIO) / Edge key / JWT ES256 ... (Ngày 17, 36+)
