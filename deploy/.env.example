# Biến môi trường cho Docker Compose dev (deploy/docker-compose.yml).
# Chép file này thành deploy/.env rồi chỉnh. KHÔNG commit deploy/.env.

# --- PostgreSQL (Ngày 3) ---
POSTGRES_USER=cdp
POSTGRES_PASSWORD=cdp_dev_pw
POSTGRES_DB=cdp
POSTGRES_PORT=5432

# --- Core_API (Ngày 15) ---
# Môi trường ASP.NET trong container (Development|Staging|Production).
ASPNETCORE_ENVIRONMENT=Production
# Cổng host map tới core-api (container luôn nghe 8080).
CORE_API_PORT=8080
# App:SelfUrl trong container (override mặc định https://localhost:44382 của dev).
CORE_API_SELF_URL=http://localhost:8080

# --- SuperAdmin ban đầu (Ngày 26, Req 25.6–25.7) ---
# BẮT BUỘC đặt SEED_SUPERADMIN_PASSWORD trước khi chạy migrator; KHÔNG có mặc định trong mã nguồn.
# Mật khẩu: 12–128 ký tự và có đủ chữ hoa, chữ thường, chữ số, ký tự đặc biệt.
# Để trống thì migrator dừng và báo tên biến thiếu (không in giá trị). Nếu email đã tồn tại thì không đổi mật khẩu.
SEED_SUPERADMIN_EMAIL=superadmin@example.com
SEED_SUPERADMIN_PASSWORD=

# --- Edge key (Ngày 36, Req 28.12) ---
# BẮT BUỘC cho core-api (≥ 32 ký tự, ngẫu nhiên). Thiếu thì core-api thoát mã khác 0 khi khởi động.
# Mọi request tới Core_API (trừ GET /health/live) phải gửi header X-Edge-Key trùng giá trị này, sai/thiếu thì 404 rỗng.
# Sinh khóa (PowerShell):  -join ((1..32) | % { '{0:x2}' -f (Get-Random -Maximum 256) })
# Sinh khóa (bash):        openssl rand -hex 32
EDGE_KEY=

# --- Các biến dưới đây thêm dần ở các ngày sau (chỉ liệt kê trước để tham khảo) ---
# BFF / Object_Storage (MinIO) / Edge key / JWT ES256 ... (Ngày 17, 36+)
